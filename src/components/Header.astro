---
import { languages, defaultLanguage, type Language } from '../i18n/languages';
import { navigationTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const navigation = navigationTranslations[language];
const baseUrl = import.meta.env.BASE_URL;
const languageHomeUrl = `${baseUrl}${language}/`;
---

<header class="site-header">
  <div class="header-container">
    <a class="brand" href={languageHomeUrl}>
      STM Balance
    </a>

    <nav class="main-navigation" aria-label="Navegación principal">
      <a href={languageHomeUrl}>{navigation.home}</a>
      <a href="#producto">{navigation.product}</a>
      <a href="#tecnologia">{navigation.technology}</a>
      <a href="#instituciones">{navigation.institutions}</a>
      <a href="#equipo">{navigation.team}</a>
      <a href="#empresa">{navigation.company}</a>
      <a href="#contacto">{navigation.contact}</a>
    </nav>
    <div class="language-switcher">
      <details>
        <summary>{languages[language]}</summary>

        <div class="language-menu">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={`${baseUrl}${code}/`}
              aria-current={code === language ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </details>
    </div>
  </div>
</header>
