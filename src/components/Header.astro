---
import { languages, defaultLanguage, type Language } from '../i18n/languages';
import { navigationTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const navigation = navigationTranslations[language];

const navigationAriaLabels: Record<Language, string> = {
  es: 'Navegación principal',
  pt: 'Navegação principal',
  en: 'Main navigation',
  ru: 'Основная навигация',
  fr: 'Navigation principale',
  de: 'Hauptnavigation',
};

const navigationAriaLabel = navigationAriaLabels[language];

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const languageHomeUrl = `${baseUrl}${language}/`;

const relativePath = Astro.url.pathname.startsWith(baseUrl)
  ? Astro.url.pathname.slice(baseUrl.length)
  : Astro.url.pathname.replace(/^\/+/, '');

const pathSegments = relativePath
  .split('/')
  .filter(Boolean);

const currentPagePath = pathSegments.length > 1
  ? pathSegments.slice(1).join('/')
  : '';

const getLanguageUrl = (code: string) =>
  `${baseUrl}${code}/${currentPagePath ? `${currentPagePath}/` : ''}`;
---

<header class="site-header">
  <div class="header-container">
    <a class="brand" href={languageHomeUrl}>
      STM Balance
    </a>

    <nav class="main-navigation" aria-label="Navegación principal">
      <a href={languageHomeUrl}>{navigation.home}</a>
      <a href={`${languageHomeUrl}#producto`}>{navigation.product}</a>
      <a href={`${languageHomeUrl}#tecnologia`}>{navigation.technology}</a>
      <a href={`${languageHomeUrl}#instituciones`}>{navigation.institutions}</a>
      <a href={`${languageHomeUrl}#empresa`}>{navigation.company}</a>
      <a href={`${languageHomeUrl}#equipo`}>{navigation.team}</a>
      <a href={`${languageHomeUrl}#contacto`}>{navigation.contact}</a>
    </nav>

    <div class="language-switcher">
      <details>
        <summary>{languages[language]}</summary>

        <div class="language-menu">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={getLanguageUrl(code)}
              aria-current={code === language ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </details>
    </div>

    <details class="mobile-menu">
      <summary class="mobile-menu-toggle">
        <span></span>
        <span></span>
        <span></span>
      </summary>

      <div class="mobile-menu-panel">
        <nav class="mobile-navigation" aria-label="Navegación principal">
          <a href={languageHomeUrl}>{navigation.home}</a>
          <a href={`${languageHomeUrl}#producto`}>{navigation.product}</a>
          <a href={`${languageHomeUrl}#tecnologia`}>{navigation.technology}</a>
          <a href={`${languageHomeUrl}#instituciones`}>{navigation.institutions}</a>
          <a href={`${languageHomeUrl}#empresa`}>{navigation.company}</a>
          <a href={`${languageHomeUrl}#equipo`}>{navigation.team}</a>
          <a href={`${languageHomeUrl}#contacto`}>{navigation.contact}</a>
        </nav>

        <div class="mobile-language-menu">
          {Object.entries(languages).map(([code, label]) => (
            <a
              href={getLanguageUrl(code)}
              aria-current={code === language ? 'page' : undefined}
            >
              {label}
            </a>
          ))}
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  document.querySelectorAll('.mobile-menu a').forEach((link) => {
    link.addEventListener('click', () => {
      link.closest('details')?.removeAttribute('open');
    });
  });
</script>
