---
import { defaultLanguage, type Language } from '../i18n/languages';
import { contactTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const contact = contactTranslations[language];
---

<section class="contact-section" id="contacto">
  <div class="contact-container">
    <div class="contact-content">
      <p class="section-label">{contact.label}</p>

      <h2>{contact.heading}</h2>

      <p class="section-description">
        {contact.description}
      </p>
    </div>

    <div class="contact-channels">
      {contact.channels.map((item) => (
        <article class="contact-channel">
          <h3>{item.title}</h3>

          <p>
            {item.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
