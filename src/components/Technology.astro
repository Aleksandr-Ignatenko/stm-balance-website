---
import { defaultLanguage, type Language } from '../i18n/languages';
import { technologyTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const technology = technologyTranslations[language];
---

<section class="technology-section" id="tecnologia">
  <div class="technology-container">
    <div class="technology-content">
      <p class="section-label">{technology.label}</p>

      <h2>{technology.heading}</h2>

      <p class="section-description">
        {technology.description}
      </p>
    </div>
  </div>
</section>
