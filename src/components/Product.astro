---
import { defaultLanguage, type Language } from '../i18n/languages';
import { productTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const product = productTranslations[language];

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const productMockupUrl = `${baseUrl}images/product/stm-balance-mockup.png`;

const getStatusLabel = (
  status: 'implemented' | 'development' | 'future'
) => {
  switch (status) {
    case 'implemented':
      return product.implementedStatus;

    case 'development':
      return product.developmentStatus;

    case 'future':
      return product.futureStatus;
  }
};
---

<section class="product-section" id="producto">
  <div class="product-container">
    <div class="product-content">
      <p class="section-label">{product.label}</p>

      <h2>{product.heading}</h2>

      <p class="section-description">
        {product.description}
      </p>
    </div>

    <div class="product-visual">
      <img
        class="product-mockup"
        src={productMockupUrl}
        alt="STM Balance"
        width="401"
        height="803"
        loading="lazy"
      />
    </div>

    <div class="product-features">
      {product.features.map((feature) => (
        <article class="product-feature">
          <p class={`product-feature-status product-feature-status--${feature.status}`}>
            {getStatusLabel(feature.status)}
          </p>

          <h3>{feature.title}</h3>

          <p class="product-feature-description">
            {feature.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</section>
