---
import { defaultLanguage, type Language } from '../i18n/languages';
import { institutionsTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const institutions = institutionsTranslations[language];
---

<section class="institutions-section" id="instituciones">
  <div class="institutions-container">
    <div class="institutions-content">
      <p class="section-label">{institutions.label}</p>

      <h2>{institutions.heading}</h2>

      <p class="section-description">
        {institutions.description}
      </p>
    </div>
  </div>
</section>
