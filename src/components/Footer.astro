---
import { defaultLanguage, type Language } from '../i18n/languages';
import { footerTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const footer = footerTranslations[language];
---

<footer class="site-footer">
  <div class="footer-container">
    <p>STM Balance</p>
    <p>{footer.developedBy}</p>
    <p>{footer.location}</p>
  </div>
</footer>
