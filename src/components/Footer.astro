---
import { defaultLanguage, type Language } from '../i18n/languages';
import { footerTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const footer = footerTranslations[language];

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const linkedinIconUrl = `${baseUrl}images/social/linkedin.svg`;
const xIconUrl = `${baseUrl}images/social/x.svg`;
const telegramIconUrl = `${baseUrl}images/social/telegram.svg`;
const emailIconUrl = `${baseUrl}images/social/email.svg`;

const privacyUrl = `${baseUrl}${language}/privacy/`;
const termsUrl = `${baseUrl}${language}/terms/`;
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-brand">
      <p>STM Balance</p>
      <p>{footer.copyright}</p>
      <p>{footer.location}</p>
    </div>

    <div class="footer-legal">
      <a href={privacyUrl}>{footer.privacy}</a>
      <a href={termsUrl}>{footer.terms}</a>
    </div>

    <div class="footer-social">
      <span>
        <img
          src={linkedinIconUrl}
          alt="LinkedIn"
          width="32"
          height="32"
        />
      </span>

      <span>
        <img
          src={xIconUrl}
          alt="X"
          width="32"
          height="32"
        />
      </span>

      <span>
        <img
          src={telegramIconUrl}
          alt="Telegram"
          width="32"
          height="32"
        />
      </span>

      <span>
        <img
          src={emailIconUrl}
          alt="Email"
          width="32"
          height="32"
        />
      </span>
    </div>
  </div>
</footer>
