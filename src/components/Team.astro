---
import { defaultLanguage, type Language } from '../i18n/languages';
import { teamTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const team = teamTranslations[language];
---

<section class="team-section" id="equipo">
  <div class="team-container">
    <div class="team-content">
      <p class="section-label">{team.label}</p>

      <h2>{team.heading}</h2>

      <p class="section-description">
        {team.description}
      </p>
    </div>
  </div>
</section>
