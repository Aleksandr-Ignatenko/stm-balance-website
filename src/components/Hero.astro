---
import { defaultLanguage, type Language } from '../i18n/languages';
import { heroTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const hero = heroTranslations[language];

// Временно скрываем старый текстовый блок Hero на всех языках.
const showHeroContent = false;

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const heroSlides = Array.from(
  { length: 9 },
  (_, index) =>
    `${baseUrl}images/hero/slides/stm-balance-hero-${String(index + 1).padStart(2, '0')}.jpg`
);

const heroLogoUrl = `${baseUrl}images/hero/overlay/w.png`;

const firstSlide = hero.slider.slides[0];

const [brandStrong, ...brandRestParts] = firstSlide.brand.split(' ');
const brandRest = brandRestParts.join(' ');
---

<section class="hero">
  <div class="hero-container">
    {showHeroContent && (
      <div class="hero-content">
        <p class="hero-label">{hero.label}</p>

        <h1>STM Balance</h1>

        <h2>
          {hero.heading}
        </h2>

        <p class="hero-description">
          {hero.description}
        </p>
      </div>
    )}

    <div
      class="hero-slider"
      data-hero-slider
      aria-roledescription="carousel"
    >
      <img
        class="hero-slider-logo"
        src={heroLogoUrl}
        alt=""
        width="98"
        height="179"
        aria-hidden="true"
        draggable="false"
      />

      <div class="hero-slider-track">
        {heroSlides.map((src, index) => (
          <div
            class:list={[
              'hero-slide',
              { 'hero-slide--active': index === 0 }
            ]}
            data-hero-slide
            aria-hidden={index === 0 ? 'false' : 'true'}
          >
            <img
              src={src}
              alt=""
              width="1672"
              height="941"
              loading={index === 0 ? 'eager' : 'lazy'}
              fetchpriority={index === 0 ? 'high' : 'auto'}
            />

            {index === 0 && (
              <div
                class={`hero-slide-copy hero-slide-copy--${language}`}
              >
                <h1 class="hero-slide-brand">
                  <strong>{brandStrong}</strong>
                  {brandRest && <span> {brandRest}</span>}
                </h1>

                <p class="hero-slide-heading">
                  {firstSlide.heading}
                </p>

                <p class="hero-slide-description">
                  {firstSlide.description}
                </p>
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="hero-slider-dots">
        {heroSlides.map((_, index) => (
          <button
            class:list={[
              'hero-slider-dot',
              { 'hero-slider-dot--active': index === 0 }
            ]}
            type="button"
            data-hero-dot={index}
            aria-label={`${hero.slider.navigationLabel} ${index + 1}`}
            aria-current={index === 0 ? 'true' : undefined}
          ></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const slider = document.querySelector<HTMLElement>('[data-hero-slider]');

  if (slider) {
    const slides = Array.from(
      slider.querySelectorAll<HTMLElement>('[data-hero-slide]')
    );

    const dots = Array.from(
      slider.querySelectorAll<HTMLButtonElement>('[data-hero-dot]')
    );

    let currentIndex = 0;
    let autoplayTimer: number | undefined;

    const reducedMotion = window.matchMedia(
      '(prefers-reduced-motion: reduce)'
    ).matches;

    const showSlide = (index: number) => {
      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === currentIndex;

        slide.classList.toggle('hero-slide--active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      dots.forEach((dot, dotIndex) => {
        const isActive = dotIndex === currentIndex;

        dot.classList.toggle('hero-slider-dot--active', isActive);

        if (isActive) {
          dot.setAttribute('aria-current', 'true');
        } else {
          dot.removeAttribute('aria-current');
        }
      });
    };

    const stopAutoplay = () => {
      if (autoplayTimer !== undefined) {
        window.clearInterval(autoplayTimer);
        autoplayTimer = undefined;
      }
    };

    const startAutoplay = () => {
      if (reducedMotion) {
        return;
      }

      stopAutoplay();

      autoplayTimer = window.setInterval(() => {
        showSlide(currentIndex + 1);
      }, 6000);
    };

    dots.forEach((dot, index) => {
      dot.addEventListener('click', () => {
        showSlide(index);
        startAutoplay();
      });
    });

    slider.addEventListener('mouseenter', stopAutoplay);
    slider.addEventListener('mouseleave', startAutoplay);

    slider.addEventListener('focusin', stopAutoplay);
    slider.addEventListener('focusout', startAutoplay);

    startAutoplay();
  }
</script>
