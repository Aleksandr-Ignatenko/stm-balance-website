---
import { defaultLanguage, type Language } from '../i18n/languages';
import { heroTranslations } from '../i18n/translations';

const {
  language = defaultLanguage
} = Astro.props as {
  language?: Language;
};

const hero = heroTranslations[language];

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const heroMockupUrl = `${baseUrl}images/hero/stm-balance-mockup-${language}.jpg`;
---

<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <p class="hero-label">{hero.label}</p>

      <h1>STM Balance</h1>

      <h2>
        {hero.heading}
      </h2>

      <p class="hero-description">
        {hero.description}
      </p>
    </div>

    <div class="hero-visual">
      <img
        class="hero-mockup"
        src={heroMockupUrl}
        alt="STM Balance"
        width="1122"
        height="1402"
        fetchpriority="high"
      />
    </div>
  </div>
</section>
