---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Allgemeine Geschäftsbedingungen — STM Balance"
  description="Allgemeine Geschäftsbedingungen für die Nutzung der STM-Balance-Website."
  language="de"
  pagePath="terms"
  includeApplicationSchema={false}
