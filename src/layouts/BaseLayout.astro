---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { languages, defaultLanguage, type Language } from '../i18n/languages';
import '../styles/global.css';
import '../styles/mobile.css';

const {
  title = 'STM Balance',
  description = 'Sitio web oficial de STM Balance.',
  language = defaultLanguage
} = Astro.props as {
  title?: string;
  description?: string;
  language?: Language;
};

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

const siteUrl = Astro.site ?? new URL(Astro.url.origin);

const canonicalUrl = new URL(
  `${baseUrl}${language}/`,
  siteUrl
).toString();

const alternateLanguages = Object.keys(languages).map((code) => ({
  code,
  url: new URL(`${baseUrl}${code}/`, siteUrl).toString(),
}));

const defaultUrl = new URL(baseUrl, siteUrl).toString();

const socialImageUrl = new URL(
  `${baseUrl}images/social/stm-balance-social.jpg`,
  siteUrl
).toString();
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="STM Balance" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="STM Balance" />

    <link rel="canonical" href={canonicalUrl} />

    {alternateLanguages.map(({ code, url }) => (
      <link
        rel="alternate"
        hreflang={code}
        href={url}
      />
    ))}

    <link
      rel="alternate"
      hreflang="x-default"
      href={defaultUrl}
    />
  </head>

  <body>
    <Header language={language} />
    <slot />
    <Footer language={language} />
  </body>
</html>
